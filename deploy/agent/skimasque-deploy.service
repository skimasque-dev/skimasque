[Unit]
Description=SkiMasque release agent (pull the promoted build, verify, install, health-check)
Documentation=https://github.com/skimasque-dev/skimasque
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# SKIMASQUE_ROLE, SKIMASQUE_RELEASE_SOURCE, SKIMASQUE_SERVICE, SKIMASQUE_BINARY,
# SKIMASQUE_HEALTH, and optionally SKIMASQUE_SECRET_MAP / _SECRETS_FILE / _GCP_PROJECT.
EnvironmentFile=/etc/skimasque/deploy.env
# A fresh VM has none of these directories, and under ProtectSystem=strict systemd
# refuses to start (226/NAMESPACE) when a ReadWritePaths entry is missing. systemd
# 255 does that even for the `+` ExecStartPre below, so the two directories that do
# not exist yet are `-` prefixed (missing is fine); the `+` pre-steps create them,
# and the sandbox for ExecStart is built after they exist.
ExecStartPre=+/usr/bin/install -d -m 0755 /opt/skimasque /opt/skimasque/releases /etc/skimasque
ExecStartPre=+/usr/bin/install -d -m 0700 /var/lib/skimasque-deploy
ExecStart=/usr/local/sbin/skimasque-deploy
# It restarts the service and writes /opt and /etc/skimasque, so it runs as root,
# but with the rest of the system read-only.
ProtectSystem=strict
ReadWritePaths=-/opt/skimasque /etc/skimasque -/var/lib/skimasque-deploy
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
TimeoutStartSec=300
