# Flags for skimasque-server, read by skimasque-gateway.service.
# Everything after the binary name goes here as one line.
#
# Keep secrets (SKIMASQUE_CONTROL_TOKEN, --credential-secret) in this file,
# not in the example -- `chmod 0640 root:skimasque`.
#
# This template sets up modes 1 & 2 (SkiMasque Cloud Gateway / Customer
# Gateway): GitHub Actions OIDC as the workload identity, and SkiMasque Cloud
# as the control plane and policy source. `--control-plane` and `--policy-dir`
# are mutually exclusive -- swap the block below for the commented-out
# `--policy-dir` alternative if you'd rather manage policy as local files
# (standalone, or mode 3 with a self-hosted control plane -- point
# --control-plane at that instead of control.skimasque.com).

SKIMASQUE_ARGS=--listen 0.0.0.0:443 \
  --authority gateway.example.com \
  --cert /etc/skimasque/tls/fullchain.pem \
  --key /etc/skimasque/tls/privkey.pem \
  --tls-reload \
  --control-plane https://control.skimasque.com \
  --control-plane-state /var/lib/skimasque/control \
  --control-plane-name gateway.example.com \
  --audit-log /var/lib/skimasque/audit.jsonl \
  --metrics-listen 127.0.0.1:9090 \
  --github-oidc \
  --oidc-audience https://gateway.example.com

# One-time registration token -- needed only until /var/lib/skimasque/control
# holds an identity (dashboard → Gateways → "Mint a registration token", or
# `skimasque gateway register` on a workstation). Do NOT run `skimasque login`
# on this host.
# SKIMASQUE_CONTROL_TOKEN=skmreg_...

# A shared secret so a credential issued by one gateway is accepted by another.
# SKIMASQUE_CREDENTIAL_SECRET=<64 hex characters>

# Local static policy instead of the control plane above -- remove the
# --control-plane* lines from SKIMASQUE_ARGS if you use this:
#   --policy-dir /etc/skimasque/policies \
#   --policy-reload \
