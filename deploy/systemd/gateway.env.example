# Flags for skimasque-server, read by skimasque-gateway.service.
# Everything after the binary name goes here as one line.
#
# Keep secrets (--auth-token, --credential-secret) in this file, not here in the
# example -- `chmod 0640 root:skimasque` and prefer --github-oidc where you can.

SKIMASQUE_ARGS=--listen 0.0.0.0:4433 \
  --authority gateway.example.com:4433 \
  --cert /etc/skimasque/tls/fullchain.pem \
  --key /etc/skimasque/tls/privkey.pem \
  --tls-reload \
  --policy-dir /etc/skimasque/policies \
  --policy-reload \
  --audit-log /var/lib/skimasque/audit.jsonl \
  --connect-tcp \
  --metrics-listen 127.0.0.1:9090 \
  --github-oidc \
  --oidc-audience https://gateway.example.com

# A shared secret so a credential issued by one gateway is accepted by another.
# SKIMASQUE_CREDENTIAL_SECRET=<64 hex characters>
