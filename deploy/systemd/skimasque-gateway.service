# A hardened systemd unit for the skimasque gateway on a Linux host.
#
#   sudo install -Dm0644 deploy/systemd/skimasque-gateway.service \
#       /etc/systemd/system/skimasque-gateway.service
#   sudo install -Dm0640 deploy/systemd/gateway.env.example /etc/skimasque/gateway.env
#   sudo install -Dm0755 target/release/skimasque-server /usr/local/bin/skimasque-server
#   sudoedit /etc/skimasque/gateway.env      # set the real flags
#   sudo systemctl enable --now skimasque-gateway
#
# Policy comes from the control plane by default (gateway.env.example), cached
# under /var/lib/skimasque/control; swap in /etc/skimasque/policies/ for local
# static policy instead. TLS lives in /etc/skimasque/tls/; with
# --policy-reload / --tls-reload the gateway picks up changes in place.

[Unit]
Description=skimasque MASQUE gateway
Documentation=https://github.com/skimasque-dev/skimasque
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/skimasque/gateway.env
ExecStart=/usr/local/bin/skimasque-server $SKIMASQUE_ARGS
# SIGTERM triggers the graceful drain; give it a little longer than the
# --shutdown-grace value.
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=2

# --- identity -------------------------------------------------------------
DynamicUser=yes
StateDirectory=skimasque
# /etc/skimasque is read by the process but owned by root.
ConfigurationDirectory=skimasque

# --- sandbox -------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# QUIC is UDP; the ops listener is TCP. Nothing else.
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
# The gateway binds 443 by default (see gateway.env.example) plus the metrics
# port on loopback; CAP_NET_BIND_SERVICE is the one capability it needs,
# granted to the DynamicUser rather than running as root. Drop both lines back
# to empty if you point --listen at a port above 1024 instead.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# --- resource ceilings (belt and braces alongside the in-process limits) --
LimitNOFILE=65536
TasksMax=8192

[Install]
WantedBy=multi-user.target
