/target
**/*.rs.bk
*.pem
*.der
.env

# Deployment secrets: the *.example files are committed, the real ones are not.
deploy/**/*.env
!deploy/**/*.env.example

# Control-plane backup archives (deploy/docker/backup-control.sh).
skimasque-control-backup-*.tar.gz

# Terraform working files (the modules under deploy/terraform are consumed, never applied here).
**/.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform.tfvars

# Python bytecode (the deploy agent's tests).
__pycache__/
*.pyc
