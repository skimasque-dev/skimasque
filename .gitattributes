# Store text with LF in the repository regardless of a contributor's
# core.autocrlf setting.
* text=auto

# Files consumed by Linux tooling must be LF even in a Windows working tree,
# so a `docker build` or a copied systemd unit is not broken by CR bytes.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.service       text eol=lf
*.tpl           text eol=lf
deploy/**       text eol=lf
