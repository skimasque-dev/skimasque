# Normalize text to LF both on commit and checkout, overriding core.autocrlf.
# Automatic detection preserves binary files unchanged.
* text=auto eol=lf

# Files consumed by Linux tooling must be LF even in a Windows working tree,
# so a `docker build` or a copied systemd unit is not broken by CR bytes.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.service       text eol=lf
*.tpl           text eol=lf
deploy/**       text eol=lf

# Generated by `sitegen`; LF so `sitegen --check` compares cleanly everywhere.
site/components/** text eol=lf

# Askama templates and static assets are embedded into the generated site, so a
# CRLF checkout would leak CR bytes into `site/`. Keep them LF on disk.
crates/skimasque-visual/templates/** text eol=lf
crates/skimasque-visual/static/** text eol=lf
